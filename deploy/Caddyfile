# TLS in front of the server, for docker-compose.prod.yml. Replace the
# hostname; Caddy obtains and renews the certificate itself. The body
# limit must stay above the server's own 64 MiB upload cap, or the proxy
# rejects large reports before gocov sees them (docs/self-hosting.md).
gocov.example.com {
	request_body {
		max_size 100MB
	}
	reverse_proxy server:8080
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}
